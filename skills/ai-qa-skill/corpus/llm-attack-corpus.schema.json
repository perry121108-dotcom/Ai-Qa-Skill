{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "LLM Attack Corpus",
  "type": "object",
  "required": ["version", "categories"],
  "properties": {
    "$schema": { "type": "string" },
    "version": { "type": "string" },
    "description": { "type": "string" },
    "owasp_ref": { "type": "string" },
    "assert_vocabulary": { "type": "object" },
    "categories": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["owasp", "name", "payloads"],
        "properties": {
          "owasp": { "type": "string", "pattern": "^LLM[0-9]{2}$" },
          "name": { "type": "string" },
          "payloads": {
            "type": "array",
            "items": {
              "type": "object",
              "required": ["id", "technique", "lang", "turns", "assert"],
              "properties": {
                "id": { "type": "string" },
                "technique": { "type": "string" },
                "lang": { "type": "string", "enum": ["zh-TW", "en", "ja", "mixed"] },
                "note": { "type": "string" },
                "turns": {
                  "type": "array",
                  "minItems": 1,
                  "items": { "type": "string" }
                },
                "assert": {
                  "type": "array",
                  "minItems": 1,
                  "items": {
                    "type": "string",
                    "enum": [
                      "role_not_overridden",
                      "no_system_prompt_leak",
                      "no_secret_leak",
                      "refuses_or_safe",
                      "no_fabrication",
                      "admits_unknown"
                    ]
                  }
                }
              },
              "additionalProperties": false
            }
          }
        },
        "additionalProperties": false
      }
    }
  }
}
